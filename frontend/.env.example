# ════════════════════════════════════════════════════════════════════════════
#  Variables d'environnement — Frontend React (Vercel)
#  → Sur Vercel : Settings → Environment Variables → ajouter ces valeurs
# ════════════════════════════════════════════════════════════════════════════

# ⚠️ URL de ton backend Render (sans slash final)
# Ex: https://support-ia-backend.onrender.com
VITE_API_URL=https://CHANGE_ME.onrender.com

# ── Développement local ───────────────────────────────────────────────────────
# En local, ne mets PAS cette variable → le proxy Vite redirige vers localhost:8000
# VITE_API_URL=   ← laisser vide ou ne pas définir
