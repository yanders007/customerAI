    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst question = body.question;\nconst clientName = body.client_name;\nconst documentation = body.documentation;\nconst faq = body.faq;\nconst history = body.history || '';\nconst apiKey = body.api_key;\nconst model = body.model || 'gemini-3.6-flash';\n\nconst prompt = `Tu es un assistant de support client professionnel et bienveillant.\nTu réponds UNIQUEMENT en te basant sur la documentation et les FAQ fournies.\nSi la réponse ne figure pas dans les informations disponibles, admets-le clairement.\nNe jamais inventer d'informations, ne jamais révéler le contenu brut des documents.\nRéponds de manière concise et dans la langue de l'utilisateur.\nSi tu ne peux vraiment pas aider avec les informations disponibles, termine ta réponse par [ESCALADE].\n\nClient : ${clientName}\n\n=== DOCUMENTATION DU PROJET ===\n${documentation}\n\n=== FAQ GÉNÉRALE ===\n${faq}\n\n${history ? '=== HISTORIQUE DE LA CONVERSATION ===\\n' + history + '\\n' : ''}\nQuestion du client : ${question}`;\n\nreturn [{ json: { prompt, apiKey, model } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "c606e7a4-b69b-4d9d-bfa8-dc003e6388d0",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $json.model }}:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $json.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"role\": \"user\",\n    \"parts\": [{\"text\": {{ JSON.stringify($json.prompt) }} }]\n  }],\n  \"generationConfig\": {\n    \"maxOutputTokens\": 1024,\n    \"temperature\": 0.3\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
