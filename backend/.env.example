# ════════════════════════════════════════════════════════════════════════════
#  .env.example — Support IA (Render + Supabase + Vercel)
#  Copie ce fichier en .env et remplis les valeurs marquées ⚠️
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Support IA"
APP_ENV=production
APP_KEY=                          # ⚠️ Généré automatiquement par Render (generateValue: true)
APP_DEBUG=false
APP_URL=https://CHANGE_ME.onrender.com   # ⚠️ URL de ton service Render

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr               # stderr = visible dans les logs Render
LOG_LEVEL=error

# ── Base de données (Supabase PostgreSQL) ─────────────────────────────────────
# ⚠️ Obtenir depuis : https://supabase.com → Projet → Settings → Database
DB_CONNECTION=pgsql
DB_HOST=db.CHANGE_ME.supabase.co # ⚠️ Remplacer CHANGE_ME par ton project-ref
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME             # ⚠️ Ton mot de passe Supabase

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true        # true en HTTPS (Render = HTTPS auto)
SESSION_SAME_SITE=none            # none obligatoire si frontend ≠ domaine backend

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email (Resend — gratuit 3 000 emails/mois) ────────────────────────────────
# ⚠️ Créer un compte sur https://resend.com et obtenir une clé API (re_xxxxx)
# ⚠️ Vérifier ton domaine d'envoi sur Resend pour éviter le spam
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=CHANGE_ME           # ⚠️ Clé API Resend (re_xxxxx)
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@CHANGE_ME.com  # ⚠️ Ton domaine vérifié sur Resend
MAIL_FROM_NAME="${APP_NAME}"

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://CHANGE_ME.vercel.app  # ⚠️ URL de ton déploiement Vercel
SUPPORT_EMAIL=support@CHANGE_ME.com        # ⚠️ Email de support

# ── n8n (interne — ne PAS changer cette valeur en prod) ──────────────────────
# n8n tourne dans le même container sur le port 5678 (non exposé publiquement)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/assistant

# ── n8n Auth (pour accéder à l'UI n8n via Render Shell) ──────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME    # ⚠️ Mettre un mot de passe fort
# ⚠️ CRITIQUE : Fixe cette clé pour que les credentials n8n survivent aux redéploiements
N8N_ENCRYPTION_KEY=CHANGE_ME         # ⚠️ openssl rand -hex 32

# ── Gemini (utilisé par Laravel pour les embeddings RAG) ──────────────────────
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME             # ⚠️

# ── Cohere (embeddings pour la recherche sémantique) ─────────────────────────
# Clé gratuite : https://dashboard.cohere.com/api-keys
COHERE_API_KEY=CHANGE_ME             # ⚠️

# ── Développement local uniquement ───────────────────────────────────────────
# Décommente pour dev local avec SQLite :
# DB_CONNECTION=sqlite
# APP_ENV=local
# APP_DEBUG=true
# SESSION_SECURE_COOKIE=false
# SESSION_SAME_SITE=lax
# FRONTEND_URL=http://localhost:5173
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/assistant
